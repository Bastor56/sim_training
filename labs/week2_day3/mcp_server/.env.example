# harbor-mcp server secrets (spec.md "Callers and permissions", "Backend credentials").
# Copy to mcp_server/.env (gitignored) and replace every value. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Only the MCP server (and the backend it belongs to) may read this file.
# The agent gets ONE caller token, via its own HARBOR_MCP_TOKEN env var.

# --- Caller tokens: bearer token -> caller identity ---
MCP_TOKEN_MEMBER_ASSISTANT=replace-me
MCP_TOKEN_CONTACT_CENTRE=replace-me

# --- Mock CRM (backends/mock_crm): the key the CRM demands in X-API-Key ---
CRM_BASE_URL=http://127.0.0.1:8100
CRM_API_KEY=replace-me

# --- Core banking (local Supabase Postgres), as the least-privilege harbor_mcp role ---
HARBOR_DB_HOST=127.0.0.1
HARBOR_DB_PORT=54322
HARBOR_DB_NAME=postgres
HARBOR_DB_USER=harbor_mcp
HARBOR_DB_PASSWORD=replace-me

# --- The MCP server itself ---
MCP_HOST=127.0.0.1
MCP_PORT=8200
